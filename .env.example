PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/verdant

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me
REFRESH_JWT_SECRET=change-me-too
ADMIN_JWT_SECRET=change-me-admin

# Chave exigida para criar admins (POST /admin)
ADMIN_SECRET_KEY=change-me-admin-secret

# Rate limiting (padrão: ligado; nos testes, desligado)
RATE_LIMIT_ENABLED=true
# Atrás de proxy/load balancer: número de proxies confiáveis
# TRUST_PROXY=1

# CORS (HTTP e WebSocket): origens de navegador liberadas, separadas por vírgula ("*" = todas)
# Sem a variável: tudo liberado em dev; NADA liberado em NODE_ENV=production
# CORS_ORIGINS=https://verdant.app,https://admin.verdant.app
